{
  "lexicon": 1,
  "id": "app.aozora.convo.listSealedMessages",
  "description": "List sender-sealed messages (app.aozora.convo.sendSealed) addressed to toDid — the caller must decrypt each ciphertext (yoro-ui.interop.signal) to learn convoId's sender and read the content; nothing here reveals it server-side.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "toDid": { "type": "string" },
        "convoId": { "type": "string" },
        "limit": { "type": "integer" }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "messages": {
              "type": "array",
              "items": { "type": "ref", "ref": "#sealedMessageView" }
            }
          },
          "required": ["messages"]
        }
      }
    },
    "sealedMessageView": {
      "type": "object",
      "properties": {
        "convoId": { "type": "string" },
        "rkey": { "type": "string" },
        "toDid": { "type": "string" },
        "ciphertext": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    }
  }
}
